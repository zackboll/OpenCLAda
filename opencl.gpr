library project OpenCL is
   for Library_Name use "OpenCLAda";
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   
   for Languages use ("ada");
   
   type Mode_Type is ("debug", "release");
   Mode : Mode_Type := external ("mode", "debug");
   
   for Source_Dirs use ("src/interface", "src/implementation");

   package Compiler is
      case Mode is
         when "debug" =>
            for Default_Switches ("ada") use ("-g", "-gnatwa", "-gnatf", "-gnat2022", "-gnata");
         when "release" =>
            for Default_Switches ("ada") use ("-O2", "-gnatn2", "-gnat2022");
      end case;
   end Compiler;

   package Linker is
      for Linker_Options use ("-lOpenCL");
   end Linker;
   
end OpenCL;